# Set as Lambda environment variables (local dev needs none of these).
NODE_ENV=production
TABLE_NAME=timeclock
PUBLIC_DIR=/var/task/public
JWT_SECRET=generate-with: openssl rand -hex 32

# Sign-in
SES_FROM_EMAIL=you@yourdomain.com     # email login codes via Amazon SES
GOOGLE_CLIENT_ID=                     # "Continue with Google"
FACEBOOK_APP_ID=                      # "Continue with Facebook" (optional)
FACEBOOK_APP_SECRET=
SNS_SMS_ENABLED=false                 # SMS codes via Amazon SNS (blocked in some AWS accounts)
DEFAULT_COUNTRY_CODE=1                # 10-digit numbers are treated as +1 (use 91 for India)

# Optional
APP_NAME=TimeClock
SESSION_DAYS=30
