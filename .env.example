# ---- required in production ----
NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://USER:PASSWORD@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/timeclock
JWT_SECRET=generate-with: openssl rand -hex 32

# ---- sign-in options (enable at least one of email or SMS) ----
AWS_REGION=us-east-1
SES_FROM_EMAIL=no-reply@yourdomain.com     # email login codes via Amazon SES
SNS_SMS_ENABLED=true                        # SMS login codes via Amazon SNS
DEFAULT_COUNTRY_CODE=1                      # 10-digit numbers are treated as +1 (use 91 for India)
GOOGLE_CLIENT_ID=                           # "Continue with Google" button
FACEBOOK_APP_ID=                            # "Continue with Facebook" button
FACEBOOK_APP_SECRET=

# ---- optional ----
APP_NAME=TimeClock
SESSION_DAYS=30
DATABASE_SSL=true
